---
// The landing hero: the wordmark, the mission line, and a laptop whose screen plays
// an original 8-bit platformer loop (src/lib/platformer.ts).
//
// The laptop is a photograph cut out on a transparent background (public/hero/laptop-*.webp,
// made by scripts/cut-hero-laptop.mjs). The screen is a plane mapped onto the photo's
// display (src/lib/laptop.ts), so the game canvas sits on it, in the photo's perspective
// and clipped to its corners and notch, at every width.
// Without JS, and under prefers-reduced-motion, the screen shows a still frame
// (public/hero/platformer-still.png, rendered from the same code by
// scripts/render-hero-still.mjs). The loop pauses off screen, in a hidden tab and
// when the screen itself is clicked or activated from the keyboard (WCAG 2.2.2).
import { site } from '../site.config';
import Wordmark from './Wordmark.astro';
import ExternalLink from './ExternalLink.astro';
import { DISPLAY, IMAGE, PLANE, displayTransform } from '../lib/laptop';

const { notch } = DISPLAY;
const scene = [
	`--aspect: ${IMAGE.width / IMAGE.height}`,
	`--display-w: ${PLANE.w}cqw`,
	`--display-h: ${PLANE.h}cqw`,
	`--display-r: ${DISPLAY.radius * PLANE.w}cqw`,
	`--notch-left: ${notch.left * 100}%`,
	`--notch-w: ${(notch.right - notch.left) * 100}%`,
	`--notch-h: ${notch.depth * 100}%`,
	`--notch-r: ${notch.radius * PLANE.w}cqw`,
	`--display-transform: ${displayTransform()}`,
].join('; ');
---

<section class="hero" aria-labelledby="hero-title">
	<div class="backdrop" aria-hidden="true"></div>
	<div class="wrap inner">
		<div class="copy">
			<p class="brand"><Wordmark size="lg" /></p>
			<h1 id="hero-title">{site.mission}</h1>
			<p class="lede">
				RetroNative's projects translate a console game's machine code ahead of time into a program that runs natively on today's computers. No
				emulator in the loop, and no game files in the box: you bring your own copy.
			</p>
			<div class="ctas">
				<a class="btn" href="#projects">Explore projects</a>
				<ExternalLink class="btn btn--ghost" href={site.github.url}>RetroNative on GitHub</ExternalLink>
			</div>
		</div>

		<figure class="device">
			<div class="scene" style={scene}>
				<img
					class="body"
					src="/hero/laptop-1600.webp"
					srcset="/hero/laptop-800.webp 800w, /hero/laptop-1200.webp 1200w, /hero/laptop-1600.webp 1600w"
					sizes="(min-width: 62rem) 50vw, 100vw"
					width="1600"
					height={Math.round((1600 * IMAGE.height) / IMAGE.width)}
					alt="A laptop playing an original 8-bit side-scrolling platformer."
					decoding="async"
					fetchpriority="high"
				/>
				<div class="screen">
					<img class="still" src="/hero/platformer-still.png" width="160" height="100" alt="" decoding="async" />
					<canvas class="game" width="160" height="100" hidden></canvas>
					<div class="notch"></div>
					<div class="glass"></div>
					<button class="toggle" type="button" aria-label="Pause animation" hidden></button>
				</div>
			</div>
			<figcaption>
				Original illustration — not gameplay footage
			</figcaption>
		</figure>
	</div>
</section>

<script>
	import { createScene, LOOP, STILL_T, W } from '../lib/platformer';

	const canvas = document.querySelector<HTMLCanvasElement>('.hero .game');
	const still = document.querySelector<HTMLImageElement>('.hero .still');
	const button = document.querySelector<HTMLButtonElement>('.hero .toggle');
	const ctx = canvas?.getContext('2d');
	if (canvas && still && button && ctx) {
		const draw = createScene();
		const reduce = matchMedia('(prefers-reduced-motion: reduce)');
		let k = 1; // device pixels per game pixel
		let t = 0; // scene clock, seconds; only advances while playing
		let last = 0;
		let raf = 0;
		let visible = false;
		let paused = false;

		const resize = () => {
			const r = canvas.getBoundingClientRect();
			k = Math.min(8, Math.max(2, Math.ceil((r.width * devicePixelRatio) / W)));
			canvas.width = W * k;
			canvas.height = (W * k * 10) / 16;
			draw(ctx, reduce.matches ? STILL_T : t, k);
		};
		const frame = (now: number) => {
			t = (t + Math.min(0.1, (now - last) / 1000)) % LOOP;
			last = now;
			draw(ctx, t, k);
			raf = requestAnimationFrame(frame);
		};
		const update = () => {
			const run = visible && !paused && !reduce.matches && !document.hidden;
			button.hidden = reduce.matches;
			if (run && !raf) {
				last = performance.now();
				raf = requestAnimationFrame(frame);
			} else if (!run && raf) {
				cancelAnimationFrame(raf);
				raf = 0;
			}
			if (reduce.matches) draw(ctx, STILL_T, k);
			canvas.dataset.state = run ? 'playing' : 'paused';
		};

		t = STILL_T; // start from the frame the still shows, so nothing jumps
		canvas.hidden = false;
		still.hidden = true;
		resize();
		new ResizeObserver(resize).observe(canvas);
		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			update();
		}).observe(canvas);
		document.addEventListener('visibilitychange', update);
		reduce.addEventListener('change', update);
		button.addEventListener('click', () => {
			paused = !paused;
			button.ariaLabel = paused ? 'Play animation' : 'Pause animation';
			update();
		});
		update();
	}
</script>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3.5rem, 8vw, 6rem);
		border-bottom: 1px solid var(--line);
	}
	/* Glow, pixel grid and scanlines: static textures, no animation. */
	.backdrop {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			repeating-linear-gradient(0deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 3px),
			linear-gradient(rgb(25 227 255 / 0.06) 1px, transparent 1px) 0 0 / 32px 32px,
			linear-gradient(90deg, rgb(25 227 255 / 0.06) 1px, transparent 1px) 0 0 / 32px 32px,
			radial-gradient(60rem 30rem at 10% -10%, rgb(25 227 255 / 0.16), transparent 70%),
			radial-gradient(50rem 30rem at 100% 110%, rgb(255 77 46 / 0.14), transparent 70%),
			var(--bg-deep);
		mask-image: linear-gradient(180deg, #000 70%, transparent);
	}
	@media (min-width: 62rem) {
		.hero {
			display: grid;
			align-items: center;
			min-height: min(calc(100vh - var(--rn-header-h)), 46rem);
		}
	}
	.inner {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	@media (min-width: 62rem) {
		.inner {
			grid-template-columns: 1fr 1fr;
		}
	}
	.brand {
		margin: 0 0 1.25rem;
	}
	h1 {
		max-width: 22ch;
		margin: 0 0 1.25rem;
		font-size: clamp(1.75rem, 3.6vw, 2.75rem);
		font-weight: 500;
		color: var(--text);
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		margin-top: 2rem;
	}

	/* The laptop: the rendered body, with the screen as a plane in the render's camera.
	   Everything is in cqw of the figure, so it scales as one piece. */
	.device {
		margin: 0;
		min-width: 0;
		container-type: inline-size;
	}
	.scene {
		position: relative;
		aspect-ratio: var(--aspect);
	}
	.body {
		display: block;
		width: 100%;
		height: auto;
	}
	.screen {
		position: absolute;
		left: 0;
		top: 0;
		width: var(--display-w);
		height: var(--display-h);
		overflow: hidden;
		border-radius: var(--display-r) var(--display-r) 0 0;
		background: #000;
		transform-origin: 0 0;
		transform: var(--display-transform);
	}
	/* The game is 16:10 and the panel a little taller: cover keeps its pixels square. */
	.still,
	.game {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.still {
		image-rendering: pixelated;
	}
	.game[hidden],
	.still[hidden] {
		display: none;
	}
	/* The camera housing, cut into the top of the display. */
	.notch {
		position: absolute;
		left: var(--notch-left);
		top: 0;
		width: var(--notch-w);
		height: var(--notch-h);
		border-radius: 0 0 var(--notch-r) var(--notch-r);
		background: rgb(16 15 25); /* the photo's own notch */
	}
	/* The cover glass: a soft sheen from the studio light above, and a faint edge vignette. */
	.glass {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(172deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03) 30%, transparent 46%),
			radial-gradient(130% 120% at 50% 40%, transparent 62%, rgb(0 0 0 / 0.22));
		pointer-events: none;
	}
	figcaption {
		margin-top: 0.75rem;
		text-align: center;
		font-size: 0.8rem;
		color: var(--text-muted);
	}
	/* The screen is the pause control: no chrome, a focus ring inside the display. */
	.toggle {
		position: absolute;
		inset: 0;
		padding: 0;
		background: transparent;
		border: 0;
		border-radius: inherit;
		cursor: pointer;
	}
	.toggle:focus-visible {
		outline: 2px solid var(--rn-neon);
		outline-offset: -3px;
	}
	.toggle[hidden] {
		display: none;
	}
</style>
