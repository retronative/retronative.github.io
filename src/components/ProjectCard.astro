---
import type { Project } from '../lib/projects';
import { accentVar, targetLabel } from '../lib/projects';
import { Picture } from 'astro:assets';
import ProjectArt from './ProjectArt.astro';
import StatusBadge from './StatusBadge.astro';
import { artworkOf } from '../lib/artwork';

interface Props {
	project: Project;
	headingLevel?: 'h2' | 'h3';
}
const { project, headingLevel: H = 'h3' } = Astro.props;
const artwork = artworkOf(project.id);
const diagram = artwork?.diagram;
---

<article
	class:list={['card', `card--${project.id}`, diagram && 'card--diagram']}
	style={`--accent: ${accentVar[project.accent]}${diagram ? `; --diagram: ${diagram}` : ''}`}
>
	<div class:list={['art', artwork && 'art--photo', `art--${project.id}`]}>
		{
			artwork && (
				<Picture
					class="photo"
					src={artwork.src}
					formats={['avif', 'webp']}
					widths={[480, 800, 1200]}
					quality={55}
					sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 560px"
					alt=""
					loading="lazy"
					decoding="async"
					style={`object-position: ${artwork.focus}`}
				/>
			)
		}
		<ProjectArt project={project} />
	</div>
	<div class="body">
		<StatusBadge status={project.status} />
		<H class="name"><a href={`/projects/${project.id}/`}>{project.name}</a></H>
		<p class="tagline">{project.tagline}</p>
		<dl class="meta">
			<div><dt>Original</dt><dd>{project.game.original_platform}</dd></div>
			<div><dt>Target</dt><dd>{targetLabel(project)}</dd></div>
		</dl>
		<p class="more" aria-hidden="true">View project <span>→</span></p>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--surface);
		border: 1px solid var(--line-strong);
		clip-path: polygon(0 0, calc(100% - var(--rn-cut)) 0, 100% var(--rn-cut), 100% 100%, var(--rn-cut) 100%, 0 calc(100% - var(--rn-cut)));
		transition:
			transform var(--rn-slow) var(--rn-ease),
			border-color var(--rn-fast) var(--rn-ease);
	}
	.card::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 2px;
		background: linear-gradient(90deg, var(--accent), transparent);
	}
	.card:hover,
	.card:focus-within {
		border-color: var(--hover-border, var(--accent));
		transform: translateY(-3px);
	}
	/* The hover border and the link follow that diagram colour. */
	.card--diagram {
		--hover-border: var(--diagram);
	}
	.card--diagram .more {
		color: var(--diagram);
	}
	.art {
		position: relative;
		overflow: hidden;
		background: var(--bg-deep);
		border-bottom: 1px solid var(--line);
	}
	/* The artwork fills the header; the diagram stays on top, legible over a dark scrim. */
	.art :global(picture),
	.art :global(.photo) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.art :global(.photo) {
		object-fit: cover;
	}
	.art--photo::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 60% 70% at 50% 50%, rgb(8 10 14 / 0.35), transparent 75%),
			linear-gradient(180deg, rgb(8 10 14 / 0.25) 0%, rgb(8 10 14 / 0.12) 45%, rgb(8 10 14 / 0.65) 100%);
		pointer-events: none;
	}
	/* reFrozen's night scene is already dark: a lighter scrim keeps the archer on the left visible. */
	.art--refrozen::after {
		background:
			radial-gradient(ellipse 45% 60% at 60% 50%, rgb(8 10 14 / 0.2), transparent 75%),
			linear-gradient(180deg, rgb(8 10 14 / 0) 0%, rgb(8 10 14 / 0) 50%, rgb(8 10 14 / 0.5) 100%);
	}
	/* ReCarbon's art is magenta-lit: a cool wash pulls it toward the site's cyan. */
	.art--recarbon::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(180deg, #0a2c3a, #061620);
		mix-blend-mode: color;
		opacity: 0.6;
		pointer-events: none;
	}
	.art--photo::after {
		z-index: 1;
	}
	.art :global(svg.art) {
		position: relative;
		z-index: 2;
	}
	/* A diagram colour set for the artwork (reFrozen: green), with a dark edge. */
	.card--diagram .art :global(svg.art g) {
		--accent: var(--diagram);
		filter: drop-shadow(0 0 2px rgb(0 0 0 / 0.9));
	}
	.body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.6rem;
		flex: 1;
		padding: 1.25rem 1.25rem 1.4rem;
	}
	.name {
		margin: 0.25rem 0 0;
		font-size: 1.6rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}
	.name a {
		color: var(--text);
		text-decoration: none;
	}
	/* The whole card is the link's target area. */
	.name a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.name a:focus-visible {
		outline: none;
	}
	.card:has(.name a:focus-visible) {
		outline: 2px solid var(--focus);
		outline-offset: -4px;
	}
	.tagline {
		margin: 0;
		color: var(--text-2);
	}
	.meta {
		display: grid;
		gap: 0.25rem;
		margin: 0.25rem 0 0;
		font-size: 0.875rem;
	}
	.meta div {
		display: flex;
		gap: 0.6rem;
	}
	dt {
		min-width: 4.75rem;
		font-family: var(--rn-font-mono);
		font-size: 0.75rem;
		line-height: 1.85;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	dd {
		margin: 0;
		color: var(--text);
	}
	.more {
		margin: auto 0 0;
		padding-top: 0.5rem;
		font-family: var(--rn-font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.more span {
		display: inline-block;
		transition: transform var(--rn-fast) var(--rn-ease);
	}
	.card:hover .more span {
		transform: translateX(4px);
	}
</style>
