---
// The projects grid. Projects come from src/data/projects.json; a new port is a new entry there.
import type { Project } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
	projects: Project[];
	headingLevel?: 'h2' | 'h3';
	/** Show the empty "next slot" tile after the projects. */
	openSlot?: boolean;
}
const { projects, headingLevel = 'h3', openSlot = true } = Astro.props;
---

<ul class="gallery" role="list">
	{
		projects.map((project) => (
			<li>
				<ProjectCard project={project} headingLevel={headingLevel} />
			</li>
		))
	}
	{
		openSlot && (
			<li class="slot">
				<p class="slot-id" aria-hidden="true">SLOT {String(projects.length + 1).padStart(2, '0')}</p>
				<p class="slot-text">This slot is empty. New ports will appear here when they are announced.</p>
			</li>
		)
	}
</ul>

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.slot {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 0.5rem;
		min-height: 16rem;
		padding: 2rem 1.5rem;
		text-align: center;
		border: 1px dashed var(--line-strong);
		background: repeating-linear-gradient(-45deg, transparent 0 10px, rgb(255 255 255 / 0.015) 10px 20px);
	}
	.slot-id {
		margin: 0;
		font-family: var(--rn-font-mono);
		font-size: 0.85rem;
		letter-spacing: 0.2em;
		color: var(--text-muted);
	}
	.slot-text {
		max-width: 18rem;
		margin: 0;
		color: var(--text-2);
	}
</style>
