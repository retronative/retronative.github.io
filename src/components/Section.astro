---
// A landing-page section with its numbered mono label and heading.
interface Props {
	id: string;
	index: string;
	label: string;
	title: string;
}
const { id, index, label, title } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
	<div class="wrap">
		<header class="head">
			<p class="eyebrow"><span aria-hidden="true">{index} // </span>{label}</p>
			<h2 id={`${id}-title`}>{title}</h2>
			<div class="rule" aria-hidden="true"></div>
		</header>
		<slot />
	</div>
</section>

<style>
	.section {
		padding-block: clamp(3.5rem, 8vw, 6rem) 0;
	}
	.head {
		margin-bottom: 2.25rem;
	}
	h2 {
		margin: 0;
		font-size: clamp(1.75rem, 4vw, 2.6rem);
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}
	.rule {
		width: min(16rem, 60%);
		height: 2px;
		margin-top: 1rem;
		background: linear-gradient(90deg, var(--rn-neon), var(--rn-ember) 60%, transparent);
	}
</style>
