---
import Base from '../../layouts/Base.astro';
import { Picture } from 'astro:assets';
import ProjectArt from '../../components/ProjectArt.astro';
import { artworkOf } from '../../lib/artwork';
import StatusBadge from '../../components/StatusBadge.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { getProjects, publicLinks, techniqueLabel, targetLabel, accentVar, type Project } from '../../lib/projects';
import { site } from '../../site.config';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
	project: Project;
}
const { project } = Astro.props;
const links = publicLinks(project);
const artwork = artworkOf(project.id);
// A diagram colour set for the artwork becomes the page's accent (reFrozen: green).
const accent = artwork?.diagram ?? accentVar[project.accent];
const facts = [
	{ term: 'Game', value: project.game.title },
	{ term: 'Original platform', value: project.game.original_platform },
	{ term: 'Target', value: targetLabel(project) },
	{ term: 'Technique', value: techniqueLabel[project.technique] },
	...(project.license ? [{ term: 'License', value: project.license }] : []),
];
const checked = new Date(`${project.status.updated}T00:00:00Z`).toLocaleDateString('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});
---

<Base title={`${project.name} — ${site.name}`} description={`${project.tagline} ${project.status.label}. Unofficial fan project.`}>
	<article class="wrap page" style={`--accent: ${accent}; --page-accent: ${accent}`}>
		<nav class="crumbs" aria-label="Breadcrumb">
			<ol>
				<li><a href="/">Home</a></li>
				<li><a href="/projects/">Projects</a></li>
				<li><span aria-current="page">{project.name}</span></li>
			</ol>
		</nav>

		<header class:list={['head', artwork && 'head--photo', `head--${project.id}`]}>
			{
				artwork && (
					<Picture
						class="hero-photo"
						src={artwork.src}
						formats={['avif', 'webp']}
						widths={[640, 960, 1200]}
						quality={55}
						sizes="(max-width: 1200px) 100vw, 1200px"
						alt=""
						fetchpriority="high"
						style={`object-position: ${artwork.focus}`}
					/>
				)
			}
			<div class="head-text">
				<StatusBadge status={project.status} />
				<h1>{project.name}</h1>
				<p class="tagline">{project.tagline}</p>
			</div>
			<div class="art"><ProjectArt project={project} /></div>
		</header>

		<div class="grid">
			<div class="main">
				<section aria-labelledby="overview">
					<h2 id="overview">Overview</h2>
					<p>{project.summary}</p>
				</section>

				<section aria-labelledby="status">
					<h2 id="status">Status</h2>
					<p class="status-label">{project.status.label}</p>
					{project.status.note && <p>{project.status.note}</p>}
					<p class="small">Source: {project.status.source}. Checked {checked}.</p>
				</section>

				<section aria-labelledby="requirements">
					<h2 id="requirements">Requirements</h2>
					<ul class="reqs">
						{project.requirements.map((r) => <li>{r}</li>)}
					</ul>
				</section>

				{
					project.upstream.length > 0 && (
						<section aria-labelledby="built-on">
							<h2 id="built-on">Built on</h2>
							<ul class="reqs">
								{project.upstream.map((u) => (
									<li>
										{u.url ? <ExternalLink href={u.url}>{u.name}</ExternalLink> : <strong>{u.name}</strong>}
										{u.note && <>: {u.note}</>}
									</li>
								))}
							</ul>
						</section>
					)
				}

				<Disclaimer project={project} />
			</div>

			<aside class="side" aria-labelledby="facts">
				<h2 id="facts" class="side-title">At a glance</h2>
				<dl>
					{
						facts.map((f) => (
							<div>
								<dt>{f.term}</dt>
								<dd>{f.value}</dd>
							</div>
						))
					}
				</dl>
				<h2 class="side-title">Links</h2>
				{
					links.length > 0 ? (
						<ul class="links">
							{links.map((l) => (
								<li>
									<ExternalLink href={l.url}>
										<svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
											{l.kind === 'site' && (
												<g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
													<circle cx="12" cy="12" r="9" />
													<path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
												</g>
											)}
											{l.kind === 'repo' && (
												<path
													fill="currentColor"
													d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49l-.01-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.4 9.4 0 0 1 12 6.84c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9l-.01 2.81c0 .27.18.6.69.49A10.23 10.23 0 0 0 22 12.23C22 6.58 17.52 2 12 2z"
												/>
											)}
											{l.kind === 'issues' && (
												<g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
													<circle cx="12" cy="12" r="9" />
													<path d="M12 7.5v5.5M12 16.5h.01" />
												</g>
											)}
										</svg>
										{l.label}
									</ExternalLink>
								</li>
							))}
						</ul>
					) : (
						<p class="small">
							{project.name} has no public pages yet. Updates will appear on <ExternalLink href={site.github.url}>RetroNative's GitHub organization</ExternalLink>.
						</p>
					)
				}
			</aside>
		</div>

		<p class="back"><a href="/projects/"><span aria-hidden="true">←</span> All projects</a></p>
	</article>
</Base>

<style>
	.page {
		padding-top: clamp(1.5rem, 4vw, 2.5rem);
	}
	.crumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
		margin: 0 0 2rem;
		padding: 0;
		list-style: none;
		font-family: var(--rn-font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		color: var(--text-muted);
	}
	.crumbs li + li::before {
		content: '/';
		content: '/' / '';
		margin-inline-end: 0.5rem;
		color: var(--text-muted);
	}
	.crumbs a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}
	.crumbs span[aria-current] {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--text-2);
	}
	.head {
		display: grid;
		gap: 2rem;
		align-items: center;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--line);
	}
	@media (min-width: 52rem) {
		.head {
			grid-template-columns: 1.3fr 1fr;
		}
	}
	/* The artwork behind the hero: darker on the text side, fading into the page below. */
	.head--photo {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 2.25rem 1.75rem;
		border: 1px solid var(--line);
		clip-path: polygon(0 0, calc(100% - var(--rn-cut)) 0, 100% var(--rn-cut), 100% 100%, var(--rn-cut) 100%, 0 calc(100% - var(--rn-cut)));
	}
	.head--photo :global(picture),
	.head--photo :global(.hero-photo) {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
	}
	.head--photo :global(.hero-photo) {
		object-fit: cover;
	}
	.head--photo::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(90deg, rgb(8 10 14 / 0.78) 0%, rgb(8 10 14 / 0.5) 50%, rgb(8 10 14 / 0.25) 100%),
			linear-gradient(180deg, transparent 60%, rgb(8 10 14 / 0.55) 100%);
	}
	/* ReCarbon's magenta-lit art, pulled toward the site's cyan (as on its card). */
	.head--recarbon::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(180deg, #0a2c3a, #061620);
		mix-blend-mode: color;
		opacity: 0.6;
	}
	.head--photo .art {
		background: rgb(8 10 14 / 0.45);
	}
	.head--photo .art :global(svg g) {
		--accent: var(--page-accent);
		filter: drop-shadow(0 0 2px rgb(0 0 0 / 0.9));
	}
	h1 {
		margin: 0.75rem 0 0.75rem;
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: var(--text);
		text-shadow: 0 0 40px color-mix(in srgb, var(--accent) 35%, transparent);
	}
	.tagline {
		max-width: 36rem;
		margin: 0;
		font-size: 1.15rem;
		color: var(--text-2);
	}
	.art {
		background: var(--bg-deep);
		border: 1px solid var(--line-strong);
		clip-path: polygon(0 0, calc(100% - var(--rn-cut)) 0, 100% var(--rn-cut), 100% 100%, var(--rn-cut) 100%, 0 calc(100% - var(--rn-cut)));
	}
	.grid {
		display: grid;
		gap: 2.5rem;
		padding-top: 2.5rem;
	}
	@media (min-width: 52rem) {
		.grid {
			grid-template-columns: 1fr 20rem;
			align-items: start;
		}
	}
	.main section {
		margin-bottom: 2.25rem;
	}
	.main h2 {
		margin: 0 0 0.75rem;
		font-size: 1.4rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.main p {
		max-width: 44rem;
		color: var(--text-2);
	}
	.reqs {
		margin: 0;
		padding-left: 1.25rem;
		color: var(--text-2);
	}
	.reqs li {
		margin-bottom: 0.4rem;
	}
	.reqs li::marker {
		color: var(--accent);
	}
	strong {
		color: var(--text);
	}
	.main .status-label {
		font-family: var(--rn-font-display);
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--rn-amber);
	}
	.small {
		font-size: 0.875rem;
		color: var(--text-muted);
	}
	.side {
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-top: 2px solid var(--accent);
	}
	.side-title {
		margin: 0 0 0.75rem;
		font-family: var(--rn-font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-2);
	}
	dl {
		margin: 0 0 1.75rem;
	}
	dl div {
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--line);
	}
	dt {
		font-size: 0.8rem;
		color: var(--text-muted);
	}
	dd {
		margin: 0;
		color: var(--text);
	}
	.links {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.links li + li {
		margin-top: 0.4rem;
	}
	.links :global(a) {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		line-height: 1.5;
	}
	.link-icon {
		flex: none;
		margin-inline-end: 0.6rem;
		width: 1.15em;
		height: 1.15em;
	}
	.side .small {
		margin: 0;
	}
	.back a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 44px;
		font-family: var(--rn-font-mono);
		font-size: 0.875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
</style>
