---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
import { areas, counts, domId, guides, investigations, projects, symptoms } from '../../lib/knowledge';
import Evidence from '../../components/KnowledgeEvidence.astro';

const KB_SEARCH = 'https://github.com/retronative/knowledge/search';
const search = (...parts: (string | undefined)[]) => parts.filter(Boolean).join(' ').toLowerCase();
// The relation filters of the graph. Commits and their cites/in_project edges come with Advanced mode.
const relations = [
	{ value: 'answered_by', label: 'Symptom is documented or investigated in' },
	{ value: 'documents', label: 'Guide documents technique' },
	{ value: 'references', label: 'Document references document' },
	{ value: 'draws_on', label: 'Draws on evidence from project' },
	{ value: 'shares_evidence', label: 'Cites the same evidence (derived)' },
];
// "is documented in" -> "Documented in"
const lead = (label: string) => label.replace(/^is /, '').replace(/^./, (c) => c.toUpperCase());
const guideAreas = areas.filter((a) => guides.some((g) => g.node.area === a.id));
const investigationAreas = areas.filter((a) => investigations.some((i) => i.node.area === a.id));
---

<Base
	title={`Knowledge base — ${site.name}`}
	description="A map of RetroNative's shared porting knowledge: guides and the techniques they document, investigations of real bugs, the symptoms that lead to them and the projects whose evidence they draw on."
>
	<div class="wrap page kb">
		<p class="eyebrow">Knowledge</p>
		<h1>Knowledge base</h1>
		<p class="lede">
			What the projects learned while porting: {counts.guides} guides documenting {counts.techniques} techniques, {counts.investigations} investigations of real bugs, and
			the symptoms that lead to them. Start from a symptom, browse techniques by platform, or search.
		</p>
		<p class="note">
			This list is the complete, accessible view of the knowledge graph. An optional interactive graph further down shows the same relationships visually. The
			documents live in the retronative/knowledge repository on GitHub.
		</p>

		<form class="search" role="search" action={KB_SEARCH} method="get" data-kb-search>
			<label for="kb-q">Search the knowledge base</label>
			<div class="search-row">
				<input id="kb-q" name="q" type="search" autocomplete="off" spellcheck="false" aria-describedby="kb-q-hint" />
				<input type="hidden" name="type" value="code" />
				<button class="btn btn--ghost" type="submit" data-kb-submit>Search on GitHub</button>
			</div>
			<p id="kb-q-hint" class="hint" data-kb-hint>Searches the documents on GitHub (code search in retronative/knowledge).</p>
			<p class="status" role="status" data-kb-status></p>
		</form>

		<section class="legend" aria-labelledby="legend-h">
			<h2 id="legend-h">How to read the relationships</h2>
			<dl>
				<div>
					<dt><span class="tag">Extracted</span></dt>
					<dd>Read directly from a document: a section heading, a link, a citation or a symptom table row. Each one's file and line are under “Evidence”.</dd>
				</div>
				<div data-kb-legend-derived>
					<dt><span class="tag tag--derived">Derived</span></dt>
					<dd>
						“Cites the same evidence as”: two items cite the same project commit. That is all it says; it makes no claim about how the two topics relate. In
						the graph it is a dashed line labelled “derived”.
					</dd>
				</div>
				<div>
					<dt><span class="tag tag--inferred">Inferred</span></dt>
					<dd>A connection a maintainer reviewed and wrote down with a rationale; no document states it. Hidden unless you ask for it. In the graph it is a dotted line labelled INFERRED.</dd>
				</div>
			</dl>
			{
				counts.inferred > 0 ? (
					<p class="toggle">
						<input id="show-inferred" type="checkbox" data-kb-inferred />
						<label for="show-inferred">Show reviewed inferred relationships ({counts.inferred})</label>
					</p>
				) : (
					<p class="toggle-none">No inferred relationships are published yet: everything below is extracted or derived.</p>
				)
			}
		</section>

		<nav class="toc" aria-label="On this page">
			<ul>
				<li><a href="#symptoms">Start from a symptom</a></li>
				<li><a href="#guides">Techniques and guides</a></li>
				<li><a href="#investigations">Investigations</a></li>
				<li><a href="#projects">Projects</a></li>
				<li hidden data-kb-js><a href="#graph">Interactive graph</a></li>
			</ul>
		</nav>

		<section id="symptoms" class="block" aria-labelledby="symptoms-h">
			<h2 id="symptoms-h">Start from a symptom</h2>
			<p class="intro">What you see in a port, and where it is documented or investigated. <span class="tag">Extracted</span> from the knowledge base's symptom index.</p>
			<ul class="symptoms">
				{
					symptoms.map((s) => (
						<li id={domId(s.node.id)} data-kb-item data-kb-section="symptoms" data-search={search(s.node.label, ...s.targets.map((t) => t.node.label))}>
							<p class="symptom">
								{s.node.label} <span class="status-tag">{s.node.status}</span>
							</p>
							<ul class="leads">
								{s.targets.map((t) => (
									<li>
										{lead(t.label)} <a href={`#${domId(t.node.id)}`}>{t.node.label}</a>
									</li>
								))}
							</ul>
							<p class="item-actions">
								<button class="btn btn--ghost btn--sm" type="button" hidden data-kb-js data-show-node={s.node.id}>
									Show in graph<span class="sr-only">: {s.node.label}</span>
								</button>
							</p>
							<Evidence rows={s.evidence} label={s.node.label} />
						</li>
					))
				}
			</ul>
		</section>

		<section id="guides" class="block" aria-labelledby="guides-h">
			<h2 id="guides-h">Techniques and guides</h2>
			<p class="intro">Each guide and the techniques it documents, with a link to each section. Status labels are the guide's own.</p>
			{
				guideAreas.map((area) => (
					<div class="group" data-kb-group>
						<h3>{area.title}</h3>
						<ul class="cards">
							{guides
								.filter((g) => g.node.area === area.id)
								.map((g) => (
									<li
										class="kcard"
										id={domId(g.node.id)}
										data-kb-item
										data-kb-section="guides"
										data-search={search(g.node.label, g.node.id, ...g.techniques.map((t) => t.node.label), ...g.symptoms.map((s) => s.label), ...g.projects.map((p) => p.label))}
									>
										<h4>{g.node.label}</h4>
										<p class="path">{g.node.id}</p>
										<p class="actions">
											<a class="ext" href={g.node.href} rel="noopener">
												Read the guide<span class="sr-only"> “{g.node.label}” on GitHub</span>
											</a>
											<button class="btn btn--ghost btn--sm" type="button" hidden data-kb-js data-show-node={g.node.id}>
												Show in graph<span class="sr-only">: {g.node.label}</span>
											</button>
										</p>
										<dl class="rels">
											{g.techniques.length > 0 ? (
												<div>
													<dt>
														Techniques ({g.techniques.length}) <span class="tag">Extracted</span>
													</dt>
													<dd>
														<ul class="techniques">
															{g.techniques.map((t) => (
																<li id={domId(t.node.id)}>
																	<a href={t.node.href} rel="noopener">
																		{t.node.label}
																		<span class="sr-only"> (section on GitHub)</span>
																	</a>
																	{t.node.status && <span class="status-tag">{t.node.status}</span>}
																	{t.projects.length > 0 && <p class="sub-rel">Draws on evidence from {t.projects.map((p) => p.label).join(' and ')}</p>}
																	{t.shared.map((x) => (
																		<p class="sub-rel shared">
																			{lead(x.label)} <a href={`#${domId(x.node.id)}`}>{x.node.label}</a>{' '}
																			<span class="tag tag--derived">Derived</span>
																		</p>
																	))}
																	<Evidence rows={t.evidence} label={t.node.label} />
																</li>
															))}
														</ul>
													</dd>
												</div>
											) : (
												<div>
													<dt>Techniques</dt>
													<dd>A step-by-step checklist: its numbered steps are one procedure, so none is listed as a technique of its own.</dd>
												</div>
											)}
											{g.symptoms.length > 0 && (
												<div>
													<dt>
														Symptoms documented here <span class="tag">Extracted</span>
													</dt>
													<dd>
														<ul>
															{g.symptoms.map((s) => (
																<li>
																	<a href={`#${domId(s.id)}`}>{s.label}</a>
																</li>
															))}
														</ul>
													</dd>
												</div>
											)}
											{g.references.length > 0 && (
												<div>
													<dt>
														References <span class="tag">Extracted</span>
													</dt>
													<dd>
														<ul>
															{g.references.map((r) => (
																<li>
																	{lead(r.note)} <a href={`#${domId(r.node.id)}`}>{r.node.label}</a>
																</li>
															))}
														</ul>
													</dd>
												</div>
											)}
											{g.inferred.length > 0 && (
												<div class="inferred">
													<dt>
														Related <span class="tag tag--inferred">Inferred</span>
													</dt>
													<dd>
														<ul>
															{g.inferred.map((r) => (
																<li>
																	{lead(r.label)} <a href={`#${domId(r.node.id)}`}>{r.node.label}</a>
																	<p class="why">Rationale: {r.rationale}</p>
																</li>
															))}
														</ul>
													</dd>
												</div>
											)}
										</dl>
										<Evidence rows={g.evidence} label={g.node.label} />
									</li>
								))}
						</ul>
					</div>
				))
			}
		</section>

		<section id="investigations" class="block" aria-labelledby="investigations-h">
			<h2 id="investigations-h">Investigations</h2>
			<p class="intro">Case studies of real bugs: the symptoms, the evidence, the root cause, the fix and how it was verified.</p>
			{
				investigationAreas.map((area) => (
					<div class="group" data-kb-group>
						<h3>{area.title}</h3>
						<ul class="cards">
							{investigations
								.filter((i) => i.node.area === area.id)
								.map((i) => (
									<li
										class="kcard kcard--case"
										id={domId(i.node.id)}
										data-kb-item
										data-kb-section="investigations"
										data-search={search(i.node.label, i.node.id, ...i.symptoms.map((s) => s.label), ...i.projects.map((p) => p.label))}
									>
										<h4>{i.node.label}</h4>
										<p class="path">{i.node.id}</p>
										<p class="actions">
											<a class="ext" href={i.node.href} rel="noopener">
												Read the investigation<span class="sr-only"> “{i.node.label}” on GitHub</span>
											</a>
											<button class="btn btn--ghost btn--sm" type="button" hidden data-kb-js data-show-node={i.node.id}>
												Show in graph<span class="sr-only">: {i.node.label}</span>
											</button>
										</p>
										<dl class="rels">
											{i.symptoms.length > 0 && (
												<div>
													<dt>
														Investigates <span class="tag">Extracted</span>
													</dt>
													<dd>
														<ul>
															{i.symptoms.map((s) => (
																<li>
																	<a href={`#${domId(s.id)}`}>{s.label}</a>
																</li>
															))}
														</ul>
													</dd>
												</div>
											)}
											{i.projects.length > 0 && (
												<div>
													<dt>
														Draws on evidence from <span class="tag">Extracted</span>
													</dt>
													<dd>
														<ul>
															{i.projects.map((p) => (
																<li>
																	<a href={`#${domId(p.id)}`}>{p.label}</a>
																</li>
															))}
														</ul>
													</dd>
												</div>
											)}
											{i.shared.length > 0 && (
												<div class="shared">
													<dt>
														Cites the same evidence as <span class="tag tag--derived">Derived</span>
													</dt>
													<dd>
														<ul>
															{i.shared.map((x) => (
																<li>
																	<a href={`#${domId(x.node.id)}`}>{x.node.label}</a>
																</li>
															))}
														</ul>
													</dd>
												</div>
											)}
											{i.references.length > 0 && (
												<div>
													<dt>
														References <span class="tag">Extracted</span>
													</dt>
													<dd>
														<ul>
															{i.references.map((r) => (
																<li>
																	{lead(r.note)} <a href={`#${domId(r.node.id)}`}>{r.node.label}</a>
																</li>
															))}
														</ul>
													</dd>
												</div>
											)}
											{i.inferred.length > 0 && (
												<div class="inferred">
													<dt>
														Related <span class="tag tag--inferred">Inferred</span>
													</dt>
													<dd>
														<ul>
															{i.inferred.map((r) => (
																<li>
																	{lead(r.label)} <a href={`#${domId(r.node.id)}`}>{r.node.label}</a>
																	<p class="why">Rationale: {r.rationale}</p>
																</li>
															))}
														</ul>
													</dd>
												</div>
											)}
										</dl>
										<Evidence rows={i.evidence} label={i.node.label} />
									</li>
								))}
						</ul>
					</div>
				))
			}
		</section>

		<section id="projects" class="block" aria-labelledby="projects-h">
			<h2 id="projects-h">Projects</h2>
			<p class="intro">The ports whose commits the guides and investigations cite as evidence.</p>
			<ul class="cards cards--two">
				{
					projects.map((p) => (
						<li
							class="kcard"
							id={domId(p.node.id)}
							data-kb-item
							data-kb-section="projects"
							data-search={search(p.node.label, ...p.guides.map((d) => d.label), ...p.investigations.map((d) => d.label))}
						>
							<h3>{p.node.label}</h3>
							<p class="actions">
								<a class="ext" href={p.node.href} rel="noopener">
									Repository<span class="sr-only"> of {p.node.label} on GitHub</span>
								</a>
								<button class="btn btn--ghost btn--sm" type="button" hidden data-kb-js data-show-node={p.node.id}>
									Show in graph<span class="sr-only">: {p.node.label}</span>
								</button>
							</p>
							<dl class="rels">
								{p.guides.length > 0 && (
									<div>
										<dt>
											Guides that draw on its evidence <span class="tag">Extracted</span>
										</dt>
										<dd>
											<ul>
												{p.guides.map((d) => (
													<li>
														<a href={`#${domId(d.id)}`}>{d.label}</a>
													</li>
												))}
											</ul>
										</dd>
									</div>
								)}
								{p.investigations.length > 0 && (
									<div>
										<dt>
											Investigations that draw on its evidence <span class="tag">Extracted</span>
										</dt>
										<dd>
											<ul>
												{p.investigations.map((d) => (
													<li>
														<a href={`#${domId(d.id)}`}>{d.label}</a>
													</li>
												))}
											</ul>
										</dd>
									</div>
								)}
							</dl>
							<Evidence rows={p.evidence} label={p.node.label} />
						</li>
					))
				}
			</ul>
		</section>
		<p class="empty" hidden data-kb-empty>Nothing matches. Try fewer words, or search the documents on GitHub.</p>

		<section id="graph" class="block graph" aria-labelledby="graph-h" hidden data-kb-js data-kb-graph>
			<h2 id="graph-h">Interactive graph</h2>
			<p>
				The same {counts.primary} symptoms, guides, techniques, investigations and projects as a zoomable graph, read left to right. It loads only when you open it.
				Everything in it is also in the list above, which works with a keyboard and a screen reader. Advanced mode adds the {counts.commits} cited commits and each
				relationship's file and line.
			</p>
			<button class="btn" type="button" aria-expanded="false" aria-controls="kg-panel" data-kg-open>Show interactive graph</button>
			<p class="status" data-kg-loading role="status"></p>
			<div id="kg-panel" class="panel" hidden>
				<div class="controls">
					<label>
						<span>Project</span>
						<select data-kg-project>
							<option value="">All projects</option>
							{projects.map((p) => <option value={p.node.id}>{p.node.label}</option>)}
						</select>
					</label>
					<label>
						<span>Area</span>
						<select data-kg-area>
							<option value="">All areas</option>
							{areas.map((a) => <option value={a.id}>{a.title}</option>)}
						</select>
					</label>
					<label class="jump">
						<span>Select a node</span>
						<select data-kg-jump>
							<option value="">None</option>
						</select>
					</label>
					<fieldset>
						<legend>Relations</legend>
						{
							relations.map((r) => (
								<label class="check">
									<input type="checkbox" value={r.value} checked data-kg-relation />
									{r.label}
								</label>
							))
						}
						{
							counts.inferred > 0 && (
								<label class="check" for="show-inferred-graph">
									<input id="show-inferred-graph" type="checkbox" data-kg-inferred-mirror />
									Reviewed inferred (dotted, INFERRED)
								</label>
							)
						}
					</fieldset>
					<p class="check advanced">
						<input id="kg-advanced" type="checkbox" aria-describedby="kg-advanced-hint" data-kg-advanced />
						<label for="kg-advanced">Advanced mode</label>
						<span id="kg-advanced-hint" class="hint-inline">Shows the cited commits and each relationship's file and line.</span>
					</p>
					<div class="zoom" role="group" aria-label="Zoom">
						<button class="btn btn--ghost btn--sm" type="button" data-kg-zoom-in aria-label="Zoom in">+</button>
						<button class="btn btn--ghost btn--sm" type="button" data-kg-zoom-out aria-label="Zoom out">−</button>
						<button class="btn btn--ghost btn--sm" type="button" data-kg-fit>Fit</button>
					</div>
				</div>
				<div class="stage">
					<div
						class="canvas"
						role="img"
						aria-label="Knowledge graph, left to right: symptoms, guides and investigations, techniques, projects. The list above is the accessible equivalent."
						data-kg-canvas
					>
					</div>
					<div class="details">
						<h3 id="kg-details-h" class="sr-only">Selected node</h3>
						<p class="sr-only" aria-live="polite" data-kg-live></p>
						<div data-kg-details tabindex="0" class="details-body" role="region" aria-label="Selection details">
							<p class="kg-d-empty">Select a node to see its relationships.</p>
						</div>
						<p class="keys">Escape clears the selection. Drag to pan, scroll or pinch to zoom.</p>
					</div>
				</div>
				<div class="legend-inline" data-kg-legend>
					<p>
						<span class="legend-h">Kinds</span>
						<span><svg class="lg lg--symptom" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1 11.5 11h-11z"></path></svg>triangle: symptom</span>
						<span><svg class="lg lg--guide" viewBox="0 0 16 12" aria-hidden="true"><rect x="1" y="2.5" width="14" height="7" rx="2"></rect></svg>bar: guide</span>
						<span><svg class="lg lg--investigation" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1h6l3 5-3 5H3L0 6z"></path></svg>hexagon: investigation</span>
						<span><svg class="lg lg--technique" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4"></circle></svg>circle: technique</span>
						<span><svg class="lg lg--project" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0 12 6 6 12 0 6z"></path></svg>diamond: project</span>
						<span data-kg-legend-commit hidden><svg class="lg lg--commit" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="2" width="8" height="8"></rect></svg>square: commit (advanced)</span>
					</p>
					<p>
						<span class="legend-h">Lines</span>
						<span>solid: extracted</span>
						<span>dashed, labelled “derived”: cites the same evidence</span>
						{counts.inferred > 0 && <span>dotted, labelled INFERRED: reviewed inferred</span>}
					</p>
				</div>
			</div>
		</section>
	</div>
</Base>

<script>
	type GraphApi = Awaited<ReturnType<(typeof import('../../lib/knowledge-graph-view'))['mountGraph']>>;

	const $ = <T extends Element>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
	const $$ = <T extends Element>(sel: string, root: ParentNode = document) => [...root.querySelectorAll<T>(sel)];

	for (const el of $$<HTMLElement>('[data-kb-js]')) el.hidden = false;

	// Search: with JavaScript, the box filters the list in place instead of leaving for GitHub.
	const form = $<HTMLFormElement>('[data-kb-search]');
	const input = $<HTMLInputElement>('#kb-q');
	const status = $<HTMLElement>('[data-kb-status]');
	const items = $$<HTMLElement>('[data-kb-item]');
	const empty = $<HTMLElement>('[data-kb-empty]');
	$<HTMLElement>('[data-kb-submit]').textContent = 'Filter';
	$<HTMLElement>('[data-kb-hint]').textContent = 'Filters the symptoms, guides, investigations and projects on this page as you type.';

	let graph: GraphApi | null = null;
	let timer = 0;
	function filter() {
		const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
		let shown = 0;
		for (const item of items) {
			const hit = words.every((w) => item.dataset.search!.includes(w));
			item.hidden = !hit;
			if (hit) shown++;
		}
		for (const group of $$<HTMLElement>('[data-kb-group]')) group.hidden = !$$('[data-kb-item]:not([hidden])', group).length;
		empty.hidden = shown > 0;
		graph?.setQuery(input.value);
		clearTimeout(timer);
		timer = window.setTimeout(() => {
			status.textContent = words.length ? `${shown} of ${items.length} items match.` : '';
		}, 300);
	}
	input.addEventListener('input', filter);
	form.addEventListener('submit', (e) => {
		e.preventDefault();
		filter();
	});

	// Inferred toggle (rendered only when the graph has inferred edges): CSS shows the list items; the graph mirrors it.
	const inferred = document.querySelector<HTMLInputElement>('[data-kb-inferred]');
	const mirror = document.querySelector<HTMLInputElement>('[data-kg-inferred-mirror]');
	if (inferred && mirror) {
		inferred.addEventListener('change', () => {
			mirror.checked = inferred.checked;
			mirror.dispatchEvent(new Event('change'));
		});
		mirror.addEventListener('change', (e) => {
			if (!e.isTrusted) return;
			inferred.checked = mirror.checked;
		});
	}

	// Graph: loaded by dynamic import only when opened.
	const section = $<HTMLElement>('[data-kb-graph]');
	const panel = $<HTMLElement>('#kg-panel');
	const open = $<HTMLButtonElement>('[data-kg-open]');
	const loading = $<HTMLElement>('[data-kg-loading]');
	let mounting: Promise<GraphApi | null> | null = null;

	function show() {
		panel.hidden = false;
		open.setAttribute('aria-expanded', 'true');
		open.textContent = 'Hide interactive graph';
		graph?.resize();
	}
	function load(): Promise<GraphApi | null> {
		show();
		mounting ??= (async () => {
			loading.textContent = 'Loading the graph…';
			try {
				const { mountGraph } = await import('../../lib/knowledge-graph-view');
				graph = await mountGraph('/knowledge/graph.json', {
					container: $('[data-kg-canvas]'),
					details: $('[data-kg-details]'),
					live: $('[data-kg-live]'),
					project: $('[data-kg-project]'),
					area: $('[data-kg-area]'),
					relations: $$('[data-kg-relation]'),
					inferred: mirror,
					advanced,
					legendCommit: $('[data-kg-legend-commit]'),
					jump: $('[data-kg-jump]'),
					zoomIn: $('[data-kg-zoom-in]'),
					zoomOut: $('[data-kg-zoom-out]'),
					fit: $('[data-kg-fit]'),
				});
				section.dataset.state = 'ready';
				graph.setQuery(input.value);
				loading.textContent = `Graph loaded: ${graph.nodeCount} nodes shown.`;
				return graph;
			} catch (err) {
				loading.textContent = 'The graph could not be loaded. The list above has the same information.';
				mounting = null;
				console.warn(err);
				return null;
			}
		})();
		return mounting;
	}

	// Advanced mode (commits and file:line evidence): a real checkbox, mirrored in the URL as #advanced so it can be shared.
	// Only the checkbox turns it off; following an in-page link that replaces the hash does not.
	const advanced = $<HTMLInputElement>('[data-kg-advanced]');
	advanced.addEventListener('change', () => history.replaceState(null, '', advanced.checked ? '#advanced' : location.pathname + location.search));
	const fromHash = () => {
		if (location.hash !== '#advanced') return;
		if (!advanced.checked) {
			advanced.checked = true;
			advanced.dispatchEvent(new Event('change'));
		}
		load().then(() => section.scrollIntoView({ block: 'start' }));
	};
	addEventListener('hashchange', fromHash);
	fromHash();

	open.addEventListener('click', () => {
		if (open.getAttribute('aria-expanded') === 'true') {
			panel.hidden = true;
			open.setAttribute('aria-expanded', 'false');
			open.textContent = 'Show interactive graph';
		} else load();
	});

	for (const button of $$<HTMLButtonElement>('[data-show-node]')) {
		button.addEventListener('click', async () => {
			const g = await load();
			if (!g) return;
			panel.scrollIntoView({ block: 'start' });
			g.select(button.dataset.showNode!, { focus: true });
		});
	}

	// Wide screens: load once the panel is scrolled into view (never on first render, never on phones).
	if (matchMedia('(min-width: 64rem)').matches && 'IntersectionObserver' in window) {
		const io = new IntersectionObserver((entries) => {
			if (entries.some((e) => e.isIntersecting) && window.scrollY > 0) {
				io.disconnect();
				// Opening grows the section; keep what is below it (e.g. a focused footer link) where it was.
				const before = section.getBoundingClientRect();
				const active = document.activeElement;
				const below = !!active && active !== document.body && !!(section.compareDocumentPosition(active) & Node.DOCUMENT_POSITION_FOLLOWING);
				load();
				if (before.top < 0 || below) window.scrollBy(0, section.getBoundingClientRect().height - before.height);
			}
		});
		io.observe(section);
	}
</script>

